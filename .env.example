# =====================================================================
#  Sharma Cafe WhatsApp AI Agent — Environment Config (.env)
#  Is file ko copy karke ".env" naam se save karo, phir apni keys daalo.
#  .env file KABHI GitHub par push mat karna (warna chabi chori ho jayegi).
# =====================================================================

# ---------------- RESTAURANT PROFILE ----------------
RESTAURANT_NAME="Sharma Cafe"
RESTAURANT_CITY="Jaipur"
RESTAURANT_TAGLINE="Ghar jaisa swaad, dost jaisa andaaz"
RESTAURANT_ADDRESS="12, MI Road, Jaipur, Rajasthan 302001"
RESTAURANT_PHONE="+919876543210"
RESTAURANT_EMAIL="hello@sharmacafe.in"
RESTAURANT_HOURS="11:00 AM - 11:00 PM (Daily)"
GOOGLE_REVIEW_LINK="https://g.page/r/sharma-cafe/review"
# Owner ka WhatsApp number — alert aur daily report isi par jayega
OWNER_WHATSAPP="919876543210"
# Staff ka number — "insaan se baat karni hai" par yahan transfer hoga
STAFF_WHATSAPP="919876543211"

# ---------------- AGENT PERSONALITY ----------------
AGENT_NAME="Bablu"
AGENT_PERSONA_EXTRA="Bilkul bhi robot jaisa mat lagao. Chhote mazak theek hain, lekin izzat kabhi na todo."

# ---------------- BILL / TAX ----------------
GST_PERCENT=5
PACKAGING_CHARGE=0
DELIVERY_CHARGE=0
CURRENCY="INR"
# Safety: AI kitna % discount de sakta hai (rule engine isi cap me chalega)
MAX_DISCOUNT_PERCENT=25

# ---------------- WHATSAPP CLOUD API ----------------
# mock = bina Meta account ke demo chalega (dashboard ke Live Chat se test karo)
# live = asli WhatsApp par message jayega
WHATSAPP_MODE="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# Local demo value only; production me apna random token (>=24 chars) set karein.
WHATSAPP_VERIFY_TOKEN="sharma-cafe-verify-2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# ---------------- AI (LLM) ----------------
# auth | demo   (auth = asli AI, demo = built-in Hinglish brain, koi key nahi chahiye)
LLM_MODE="demo"
# openai | gemini | groq | ollama | custom
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=350

# ---------------- PAYMENT (Razorpay) ----------------
# mock = local demo payment page (DEMO ONLY), live = asli Razorpay (webhook signature zaroori)
PAYMENT_MODE="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard > Webhooks me jo secret daala hai (API key secret se ALAG hai)
RAZORPAY_WEBHOOK_SECRET=""
UPI_ID="sharmacafe@upi"

# ---------------- DATABASE ----------------
# SQLite default (zero setup). Postgres ke liye: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL="sqlite:///./data/sharma_cafe.db"
# Docker compose ke Postgres ka password — KHUD ek lamba random value daalo (docker compose isi ke bina nahi chalega)
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ---------------- AUTOMATION ----------------
AUTOMATION_ENABLED=true
OWNER_REPORT_TIME="23:00"
BIRTHDAY_TIME="09:00"
WINBACK_DAYS=30
RESERVATION_REMINDER_MINUTES=60
MAX_PROACTIVE_PER_DAY=200

# ---------------- PUBLIC URL ----------------
# Live server ka address — payment links isi se bante hain (khaali chhodo to localhost)
PUBLIC_BASE_URL=""

# ---------------- APP ENVIRONMENT ----------------
# development | demo | production
#  development/demo: ADMIN_TOKEN khaali ho to dashboard API bina token ke khulti hai (sirf local demo!)
#  production: galat config ho to app start hi nahi hota (docs/DEPLOYMENT.md)
APP_ENV="development"
# Local demo fixtures only. Set DEMO_SEED=false in production; startup rejects production when true.
DEMO_SEED=true

# ---------------- DASHBOARD ----------------
# Dashboard API ka admin token. Production me kam se kam 24 random characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=""
PORT=8000
# Reverse proxy ke IP(s) jinke X-Forwarded headers trust karne hain (comma separated)
FORWARDED_ALLOW_IPS="127.0.0.1"

# ---------------- RESERVATIONS ----------------
RESERVATION_MAX_SEATS=24
RESERVATION_WINDOW_MINUTES=90
